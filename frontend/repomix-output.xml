<file path="src/components/common/MetricGauge.tsx">
import React from 'react';
import clsx from 'clsx';

interface MetricGaugeProps {
  value: number;
  min: number;
  max: number;
  unit: string;
  label: string;
  optimalRange?: [number, number];
  warningThreshold?: number;
  criticalThreshold?: number;
  reverseDanger?: boolean; // if true, lower values are more dangerous (like pH low)
  size?: 'sm' | 'md' | 'lg';
  precision?: number;
  showTicks?: boolean;
  colorScheme?: 'cyan' | 'teal' | 'emerald' | 'amber' | 'rose' | 'adaptive';
}

export const MetricGauge: React.FC<MetricGaugeProps> = ({
  value,
  min,
  max,
  unit,
  label,
  optimalRange,
  warningThreshold,
  criticalThreshold,
  reverseDanger = false,
  size = 'md',
  precision = 1,
  showTicks = true,
  colorScheme = 'adaptive',
}) => {
  // Normalize percentage
  const clampedVal = Math.max(min, Math.min(max, value));
  const percentage = Math.round(((clampedVal - min) / (max - min)) * 100);

  // Compute status color
  const getStatusColor = () => {
    if (colorScheme !== 'adaptive') {
      switch (colorScheme) {
        case 'cyan': return { bar: 'bg-cyan-400', text: 'text-cyan-300', glow: 'shadow-[0_0_12px_rgba(6,182,212,0.4)]' };
        case 'teal': return { bar: 'bg-teal-400', text: 'text-teal-300', glow: 'shadow-[0_0_12px_rgba(20,184,166,0.4)]' };
        case 'emerald': return { bar: 'bg-emerald-400', text: 'text-emerald-300', glow: 'shadow-[0_0_12px_rgba(16,185,129,0.4)]' };
        case 'amber': return { bar: 'bg-amber-400', text: 'text-amber-300', glow: 'shadow-[0_0_12px_rgba(245,158,11,0.4)]' };
        case 'rose': return { bar: 'bg-rose-400', text: 'text-rose-300', glow: 'shadow-[0_0_12px_rgba(244,63,94,0.4)]' };
      }
    }

    if (criticalThreshold !== undefined) {
      const isCritical = reverseDanger ? value <= criticalThreshold : value >= criticalThreshold;
      if (isCritical) {
        return { bar: 'bg-rose-500', text: 'text-rose-400', glow: 'shadow-[0_0_12px_rgba(244,63,94,0.5)]' };
      }
    }

    if (warningThreshold !== undefined) {
      const isWarning = reverseDanger ? value <= warningThreshold : value >= warningThreshold;
      if (isWarning) {
        return { bar: 'bg-amber-400', text: 'text-amber-300', glow: 'shadow-[0_0_12px_rgba(245,158,11,0.4)]' };
      }
    }

    if (optimalRange) {
      if (value < optimalRange[0] || value > optimalRange[1]) {
        return { bar: 'bg-amber-400', text: 'text-amber-300', glow: 'shadow-[0_0_12px_rgba(245,158,11,0.4)]' };
      }
    }

    return { bar: 'bg-cyan-400', text: 'text-cyan-300', glow: 'shadow-[0_0_10px_rgba(6,182,212,0.3)]' };
  };

  const status = getStatusColor();

  return (
    <div className="w-full space-y-1.5 font-mono">
      <div className="flex items-center justify-between text-xs">
        <span className="text-slate-400 text-[11px] uppercase tracking-wider">{label}</span>
        <div className="flex items-baseline gap-1">
          <span className={clsx('text-base font-bold tracking-tight', status.text)}>
            {value.toFixed(precision)}
          </span>
          <span className="text-[11px] text-slate-400 font-medium">{unit}</span>
        </div>
      </div>

      {/* Instrumentation Gauge Track */}
      <div className="relative h-2 w-full rounded-full bg-[#080e18] border border-slate-800 overflow-hidden">
        <div
          className={clsx('h-full rounded-full transition-all duration-700 ease-out', status.bar, status.glow)}
          style={{ width: `${percentage}%` }}
        />
      </div>

      {/* Gauge Scale Labels */}
      {showTicks && (
        <div className="flex justify-between text-[9px] text-slate-400 px-0.5">
          <span>{min} {unit}</span>
          {optimalRange && (
            <span className="text-cyan-400/80">
              Opt: {optimalRange[0]}-{optimalRange[1]}
            </span>
          )}
          <span>{max} {unit}</span>
        </div>
      )}
    </div>
  );
};
</file>

<file path="src/components/common/StatusPill.tsx">
import React from 'react';
import clsx from 'clsx';
import { RiskLevel, WaterConditionClassification } from '../../types';

interface StatusPillProps {
  level?: RiskLevel | 'HEALTHY' | 'WARNING' | 'CRITICAL' | 'INFO';
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  showDot?: boolean;
  className?: string;
}

export const StatusPill: React.FC<StatusPillProps> = ({
  level = 'LOW',
  label,
  size = 'md',
  showDot = true,
  className,
}) => {
  const getStyles = () => {
    switch (level) {
      case 'CRITICAL':
        return {
          bg: 'bg-rose-950/60 text-rose-300 border-rose-600/50 shadow-[0_0_10px_rgba(244,63,94,0.2)]',
          dot: 'bg-rose-400 animate-ping',
          text: label || 'CRITICAL RISK',
        };
      case 'ELEVATED':
      case 'WARNING':
        return {
          bg: 'bg-amber-950/60 text-amber-300 border-amber-600/50 shadow-[0_0_10px_rgba(245,158,11,0.2)]',
          dot: 'bg-amber-400',
          text: label || 'ELEVATED RISK',
        };
      case 'MODERATE':
        return {
          bg: 'bg-yellow-950/50 text-yellow-300 border-yellow-600/40',
          dot: 'bg-yellow-400',
          text: label || 'MODERATE RISK',
        };
      case 'LOW':
      case 'HEALTHY':
      default:
        return {
          bg: 'bg-emerald-950/50 text-emerald-300 border-emerald-600/40 shadow-[0_0_10px_rgba(16,185,129,0.15)]',
          dot: 'bg-emerald-400',
          text: label || 'NORMAL / STABLE',
        };
    }
  };

  const { bg, dot, text } = getStyles();

  const sizeClasses =
    size === 'sm'
      ? 'px-2 py-0.5 text-[10px] font-mono'
      : size === 'lg'
      ? 'px-3.5 py-1.5 text-xs font-mono font-semibold'
      : 'px-2.5 py-1 text-xs font-mono font-medium';

  return (
    <span
      className={clsx(
        'inline-flex items-center gap-1.5 rounded-full border uppercase tracking-wider',
        bg,
        sizeClasses,
        className
      )}
    >
      {showDot && (
        <span className="relative flex h-2 w-2">
          <span className={clsx('absolute inline-flex h-full w-full rounded-full opacity-75', dot)} />
          <span className={clsx('relative inline-flex rounded-full h-2 w-2', dot.split(' ')[0])} />
        </span>
      )}
      <span>{text}</span>
    </span>
  );
};
</file>

<file path="src/components/dashboard/ActiveTelemetryStreamChart.tsx">
import React, { useState } from 'react';
import {
  ResponsiveContainer,
  AreaChart,
  Area,
  XAxis,
  YAxis,
  Tooltip,
  CartesianGrid,
  ReferenceLine,
} from 'recharts';
import { DirectSensorReading, ModelDerivedData } from '../../types';
import { DirectVsModelBadge } from '../common/DirectVsModelBadge';
import { Activity, Maximize2 } from 'lucide-react';
import { formatShortTimeIST } from '../../utils/dateUtils';
import clsx from 'clsx';

interface ActiveTelemetryStreamChartProps {
  readings: DirectSensorReading[];
  models: ModelDerivedData[];
}

export const ActiveTelemetryStreamChart: React.FC<ActiveTelemetryStreamChartProps> = ({
  readings,
  models,
}) => {
  const [selectedMetric, setSelectedMetric] = useState<'temp' | 'ph' | 'risk'>('risk');

  // Format combined data for recharts using IST timestamps
  const chartData = readings.map((r, idx) => {
    const m = models[idx] || models[models.length - 1];
    const formattedTime = formatShortTimeIST(r.timestamp);

    return {
      time: formattedTime,
      timestamp: r.timestamp,
      temperature: r.temperature,
      ph: r.ph,
      riskScore: m?.riskScore || 0,
      confidence: m?.modelConfidence || 90,
    };
  });

  const getMetricConfig = () => {
    switch (selectedMetric) {
      case 'temp':
        return {
          title: 'Measured Temperature Stream',
          key: 'temperature',
          unit: '°C',
          stroke: '#06b6d4',
          fill: 'url(#tempGradient)',
          domain: ['dataMin - 1', 'dataMax + 1'],
          type: 'MEASURED' as const,
          refValue: 30.0,
          refLabel: 'Thermal Caution (30°C)',
        };
      case 'ph':
        return {
          title: 'Measured pH Level Stream',
          key: 'ph',
          unit: 'pH',
          stroke: '#14b8a6',
          fill: 'url(#phGradient)',
          domain: [5.0, 9.5],
          type: 'MEASURED' as const,
          refValue: 8.5,
          refLabel: 'Alkaline Bloom Bound (8.5 pH)',
        };
      case 'risk':
      default:
        return {
          title: 'Derived Degradation Risk Score',
          key: 'riskScore',
          unit: '/ 100',
          stroke: '#10b981',
          fill: 'url(#riskGradient)',
          domain: [0, 100],
          type: 'DERIVED' as const,
          refValue: 70,
          refLabel: 'Critical Degradation Bound (70)',
        };
    }
  };

  const config = getMetricConfig();

  return (
    <div className="rounded-xl bg-[#0a101b] border border-slate-800 p-5 shadow-lg">
      <div className="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-800">
        <div className="flex items-center gap-3">
          <div className="p-2 rounded-lg bg-[#0d1624] border border-slate-800 text-cyan-400">
            <Activity className="w-5 h-5" />
          </div>
          <div>
            <div className="flex items-center gap-2">
              <h3 className="font-mono font-bold text-sm text-slate-100">{config.title}</h3>
              <DirectVsModelBadge type={config.type} variant="minimal" />
            </div>
            <p className="text-xs text-slate-400 font-sans mt-0.5">
              High-resolution time-series buffer ({readings.length} sampled data points)
            </p>
          </div>
        </div>

        {/* Metric Selector Tabs */}
        <div className="flex items-center rounded-lg bg-[#0d1624] p-1 border border-slate-800 gap-1 font-mono text-xs">
          <button
            onClick={() => setSelectedMetric('risk')}
            className={clsx(
              'px-2.5 py-1 rounded transition-colors',
              selectedMetric === 'risk'
                ? 'bg-teal-950/80 text-teal-300 font-bold border border-teal-700/60 shadow-sm'
                : 'text-slate-400 hover:text-slate-200'
            )}
          >
            Risk Score (DERIVED)
          </button>
          <button
            onClick={() => setSelectedMetric('temp')}
            className={clsx(
              'px-2.5 py-1 rounded transition-colors',
              selectedMetric === 'temp'
                ? 'bg-cyan-950/80 text-cyan-300 font-bold border border-cyan-700/60 shadow-sm'
                : 'text-slate-400 hover:text-slate-200'
            )}
          >
            Temp (MEASURED)
          </button>
          <button
            onClick={() => setSelectedMetric('ph')}
            className={clsx(
              'px-2.5 py-1 rounded transition-colors',
              selectedMetric === 'ph'
                ? 'bg-cyan-950/80 text-cyan-300 font-bold border border-cyan-700/60 shadow-sm'
                : 'text-slate-400 hover:text-slate-200'
            )}
          >
            pH (MEASURED)
          </button>
        </div>
      </div>

      {/* Chart Canvas */}
      <div className="h-64 w-full mt-4 font-mono text-xs">
        <ResponsiveContainer width="100%" height="100%">
          <AreaChart data={chartData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>
            <defs>
              <linearGradient id="riskGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#10b981" stopOpacity={0.4} />
                <stop offset="95%" stopColor="#10b981" stopOpacity={0.0} />
              </linearGradient>
              <linearGradient id="tempGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#06b6d4" stopOpacity={0.4} />
                <stop offset="95%" stopColor="#06b6d4" stopOpacity={0.0} />
              </linearGradient>
              <linearGradient id="phGradient" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stopColor="#14b8a6" stopOpacity={0.4} />
                <stop offset="95%" stopColor="#14b8a6" stopOpacity={0.0} />
                <stop offset="5%" stopColor="#38bdf8" stopOpacity={0.4} />
                <stop offset="95%" stopColor="#38bdf8" stopOpacity={0.0} />
              </linearGradient>
            </defs>

            <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" vertical={false} />
            <XAxis
              dataKey="time"
              stroke="#64748b"
              tick={{ fontSize: 10, fill: '#94a3b8' }}
              tickLine={{ stroke: '#334155' }}
            />
            <YAxis
              stroke="#64748b"
              tick={{ fontSize: 10, fill: '#94a3b8' }}
              tickLine={{ stroke: '#334155' }}
              domain={config.domain as any}
            />
            <Tooltip
              content={({ active, payload, label }) => {
                if (active && payload && payload.length) {
                  const data = payload[0].payload;
                  return (
                    <div className="bg-[#0b1320] border border-slate-700 p-3 rounded-lg shadow-xl font-mono text-xs space-y-1">
                      <div className="text-slate-400 text-[10px]">{label} IST (Frame #{readings.indexOf(readings.find(r => r.timestamp === data.timestamp) || readings[0])})</div>
                      <div className="text-cyan-300 font-bold text-sm">
                        {payload[0].value} {config.unit}
                      </div>
                      <div className="text-[10px] text-slate-400 pt-1 border-t border-slate-800">
                        Confidence: <span className="text-emerald-400">{data.confidence}%</span>
                      </div>
                    </div>
                  );
                }
                return null;
              }}
            />
            {config.refValue && (
              <ReferenceLine
                y={config.refValue}
                stroke="#f43f5e"
                strokeDasharray="4 4"
                label={{
                  value: config.refLabel,
                  position: 'insideTopRight',
                  fill: '#f43f5e',
                  fontSize: 10,
                }}
              />
            )}
            <Area
              type="monotone"
              dataKey={config.key}
              stroke={config.stroke}
              strokeWidth={2}
              fillOpacity={1}
              fill={config.fill}
              isAnimationActive={true}
            />
          </AreaChart>
        </ResponsiveContainer>
      </div>

      <div className="flex items-center justify-between text-[11px] font-mono text-slate-400 mt-2 pt-2 border-t border-slate-800/80">
        <span className="flex items-center gap-1.5">
          <span className="w-2 h-2 rounded-full" style={{ backgroundColor: config.stroke }} />
          <span>Active Telemetry Track: <strong className="text-slate-200">{config.key.toUpperCase()}</strong></span>
        </span>
        <span className="text-slate-400">
          Continuous Ingestion Buffer
        </span>
      </div>
    </div>
  );
};
</file>

